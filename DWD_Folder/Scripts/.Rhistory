`Wettest Event` = c("May 1994 (2.6)", "May 1995 (3.0)", "Jun 1995 (2.7)", "Apr 1995 (2.7)"),
`Driest Event` = c("Jan 2019 (-3.0)", "Jan 2020 (-2.4)", "Jan 2021 (-2.9)", "Jan 2022 (-2.7)"),
`Kendall’s Tau` = c("-0.163", "-0.282", "-0.438", "-0.563"),
`Trend Significance` = c("✓", "✓", "✓✓", "✓✓✓")
)
