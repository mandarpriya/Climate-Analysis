# Filter valid peak days (non-zero)
peak_day_tbl <- hwmid_tbl %>%
filter(peak_day > 0) %>%
mutate(
peak_date = as.Date(peak_day - 1, origin = paste0(year, "-01-01")),
peak_month = format(peak_date, "%B"),  # Full month name
peak_day_of_month = format(peak_date, "%d")  # Day of the month (01–31)
)
slow_decline_events <- exceed_28c_events %>%
arrange(rate_decline) %>%
slice(1:10) %>%
mutate(label = paste0("Slow Decline: ", round(rate_decline, 2), "°C/day\n", format(date_start, "%b %d, %Y")))
