monthly_tbl <- data |>
mutate(year = year(date),
month = month(date)) |>
group_by(year, month) |>
summarise(
TMAX = mean(TMAX, na.rm = TRUE),
TMIN = mean(TMIN, na.rm = TRUE),
TAVG = mean(TAVG, na.rm = TRUE),
PRCP = sum(PRCP, na.rm = TRUE),
.groups = "drop"
) |>
mutate(date = make_date(year, month))
monthly_tbl
monthly_tbl
monthly_tbl
boxplot(monthly_tbl$TMAX)
boxplot(monthly_tbl$TMIN)
boxplot(monthly_tbl$TAVG)
monthly_long <- monthly_tbl %>%
select(month, TMAX, TAVG) %>%
pivot_longer(cols = c(TMAX, TAVG),
names_to = "variable",
values_to = "temperature")
# Create boxplot
ggplot(monthly_long, aes(x = factor(month), y = temperature, fill = variable)) +
geom_boxplot() +
scale_x_discrete(labels = month.abb) +  # Use month abbreviations
labs(x = "Month",
y = "Temperature (°C)",
title = "Monthly Distribution of TMAX and TAVG",
fill = "Variable") +
theme_minimal() +
scale_fill_manual(values = c("TMAX" = "#F8766D", "TAVG" = "#00BFC4"))
# Temperature plot
temp_plot <- ggplot(monthly_tbl, aes(x = month)) +
geom_rect(aes(xmin = month - 0.4, xmax = month + 0.4, ymin = TMIN, ymax = TMAX, fill = "Temperature Range"),
alpha = 0.7) +
geom_text(aes(y = TMAX, label = round(TMAX, 1)), vjust = -0.5, size = 3) +
geom_text(aes(y = TMIN, label = round(TMIN, 1)), vjust = 1.5, size = 3) +
scale_x_continuous(breaks = 1:12, labels = month_labels,
position = "top", expand = c(0.5, 0.5)) +
scale_y_continuous(name = NULL,
breaks = seq(-5, 25, by = 5),
limits = c(min(df$TMIN) - 5, max(df$TMAX) + 5)) +
scale_fill_manual(name = NULL,
values = c("Temperature Range" = "red"),
labels = c("Average max. and min. temperatures in °C")) +
theme_minimal() +
theme(
axis.title.x = element_blank(),
axis.text.x = element_text(margin = margin(b = 10)),
axis.ticks.x = element_line(color = "black"),
axis.text.y = element_text(size = 8),
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank(),
plot.margin = margin(t = 5, r = 5, b = 5, l = 5),
legend.position = "bottom",
legend.box.margin = margin(0, 0, 0, 0)
)
