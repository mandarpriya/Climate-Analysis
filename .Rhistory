# Precipitation plot
prcp_plot <- ggplot(monthly_tbl, aes(x = month, y = PRCP)) +
geom_col(aes(fill = "Precipitation"), alpha = 0.7) +
geom_text(aes(label = round(PRCP, 1)), vjust = 0, size = 2.5,colour = "black",fontface= "bold") +
scale_x_continuous(breaks = NULL, labels = NULL, expand = c(0.5, 0.5)) +
scale_y_continuous(name = NULL,
breaks = seq(0, 100, by = 20),
limits = c(0, max(monthly_tbl$PRCP) * 1.2)) +
scale_fill_manual(name = NULL,
values = c("Precipitation" = "blue"),
labels = c("Precipitation totals in mm")) +
theme_minimal() +
theme(
axis.text.x = element_blank(),
axis.ticks.x = element_blank(),
axis.line.x = element_blank(),
axis.title.x = element_blank(),
axis.text.y = element_text(size = 8),
plot.margin = margin(t = 5, r = 5, b = 5, l = 5),
legend.position = "bottom",
legend.box.margin = margin(0, 0, 0, 0)
)
# Combine plots with improved legend handling
combined_plot <- temp_plot / prcp_plot +
plot_layout(heights = c(2, 1)) +
plot_annotation(
title = "Climograph",
theme = theme(
plot.title = element_text(hjust = 0.5, size = 16, face = "bold")
)
)
library(ggplot2)
library(patchwork)
library(tibble)
library(tidyverse)
# Combine plots with improved legend handling
combined_plot <- temp_plot / prcp_plot +
plot_layout(heights = c(2, 1)) +
plot_annotation(
title = "Climograph",
theme = theme(
plot.title = element_text(hjust = 0.5, size = 16, face = "bold")
)
)
# Add legends at the bottom with better spacing and alignment
final_plot <- combined_plot +
plot_layout(guides = "collect") &
theme(
legend.position = "bottom",
legend.box = "vertical",
legend.spacing = unit(0, "cm"),
legend.margin = margin(0, 0, 0, 0),
legend.box.margin = margin(10, 0, 10, 0),
legend.box.spacing = unit(0, "cm"),
legend.key.size = unit(0.8, "cm"),
legend.text = element_text(size = 10),
legend.justification = "left",
legend.box.just = "left"
)
print(final_plot)
