ggplot(aes(TAVG)) +
geom_boxplot()
monthly_tbl
monthly_tbl |>
mutate(month = factor(month(date), levels = 1:12,
labels = month.abb))
monthly_tbl |>
mutate(month = factor(month(date), levels = 1:12,
labels = month.abb)) |>
ggplot(aes(x = month, y = TAVG)) +
geom_boxplot() +
labs(title = "Monthly Temperature Distribution (1891-2024)",
x = "Month",
y = "Average Temperature") +
theme_minimal()
###
monthly_tbl |>
mutate(month = factor(month(date), levels = 1:12,
labels = month.abb),
season = case_when(
month %in% c("Dec", "Jan", "Feb") ~ "Winter",
month %in% c("Mar", "Apr", "May") ~ "Spring",
month %in% c("Jun", "Jul", "Aug") ~ "Summer",
TRUE ~ "Autumn"
)) |>
ggplot(aes(x = month, y = TAVG, fill = season)) +
geom_boxplot() +
scale_fill_manual(values = c("Winter" = "#A1D6E2",
"Spring" = "#81C784",
"Summer" = "#FFB74D",
"Autumn" = "#A1887F")) +
labs(title = "Monthly Temperature Distribution in Hamburg (1891-2024)",
x = "Month",
y = "Average Temperature (°C)",
fill = "Season") +
theme_minimal()
monthly_tbl$TAVG |> max()
monthly_tbl |>
mutate(
era = case_when(
year(date) < 1918 ~ "Imperial Germany",
year(date) >= 1918 & year(date) < 1933 ~ "Weimar Republic",
year(date) >= 1933 & year(date) < 1945 ~ "Third Reich",
year(date) >= 1945 & year(date) < 1990 ~ "Divided Germany",
year(date) >= 1990 & year(date) < 2008 ~ "Reunified Germany (Pre-Financial Crisis)",
year(date) >= 2008 & year(date) < 2020 ~ "Post-Financial Crisis",
TRUE ~ "Present Era"
)
) |>
ggplot(aes(x = year(date), y = TAVG, color = era)) +
geom_point(alpha = 0.5) +
geom_smooth(method = "loess", se = TRUE) +
facet_wrap(~era, scales = "free_x") +
labs(title = "Temperature Trends in Hamburg Across German Economic Eras",
subtitle = "1891-2024",
x = "Year",
y = "Average Temperature (°C)") +
theme_minimal() +
theme(legend.position = "none")
####
# Boxplot comparison of different eras
monthly_tbl |>
mutate(
era = case_when(
year(date) < 1918 ~ "Imperial Germany",
year(date) >= 1918 & year(date) < 1933 ~ "Weimar Republic",
year(date) >= 1933 & year(date) < 1945 ~ "Third Reich",
year(date) >= 1945 & year(date) < 1990 ~ "Divided Germany",
year(date) >= 1990 & year(date) < 2008 ~ "Reunified Germany (Pre-Financial Crisis)",
year(date) >= 2008 & year(date) < 2020 ~ "Post-Financial Crisis",
TRUE ~ "Present Era"
),
era = factor(era, levels = c("Imperial Germany", "Weimar Republic", "Third Reich",
"Divided Germany", "Reunified Germany (Pre-Financial Crisis)",
"Post-Financial Crisis", "Present Era"))
) |>
ggplot(aes(x = era, y = TAVG, fill = era)) +
geom_boxplot() +
labs(title = "Temperature Distribution Across German Economic Eras in Hamburg",
x = "Era",
y = "Average Temperature (°C)") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1))
####
# Enhanced boxplot comparison with annotations
monthly_tbl |>
mutate(
era = case_when(
year(date) < 1918 ~ "Imperial Germany",
year(date) >= 1918 & year(date) < 1933 ~ "Weimar Republic",
year(date) >= 1933 & year(date) < 1945 ~ "Third Reich",
year(date) >= 1945 & year(date) < 1990 ~ "Divided Germany",
year(date) >= 1990 & year(date) < 2008 ~ "Reunified Germany (Pre-Financial Crisis)",
year(date) >= 2008 & year(date) < 2020 ~ "Post-Financial Crisis",
TRUE ~ "Present Era"
),
era = factor(era, levels = c("Imperial Germany", "Weimar Republic", "Third Reich",
"Divided Germany", "Reunified Germany (Pre-Financial Crisis)",
"Post-Financial Crisis", "Present Era"))
) |>
ggplot(aes(x = era, y = TAVG, fill = era)) +
geom_boxplot() +
stat_summary(fun = mean, geom = "point", shape = 23, size = 3, fill = "white") +
labs(title = "Temperature Distribution in Hamburg Across German Historical Periods",
subtitle = "1891-2024",
x = "",
y = "Average Temperature (°C)",
caption = "White diamonds indicate mean temperature for each period") +
theme_minimal() +
theme(axis.text.x = element_text(angle = 45, hjust = 1),
legend.position = "none") +
geom_hline(yintercept = mean(monthly_tbl$TAVG), linetype = "dashed", color = "red", alpha = 0.7)
