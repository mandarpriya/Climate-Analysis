axis.title.y.right = element_text(face = "bold", color = "black", angle = 90),
plot.margin = margin(t = 50, r = 20, b = 20, l = 20, unit = "pt")
)  +
annotate("text", x = 2011, y = 2.15, label = trend_text, size = 4, color = "black", hjust = 0, fontface = "bold")
spi_3 <- spi_3 |> filter(year > 1989)
spi_3<- spi_3|> mutate(sign = ifelse(spi_3>=0, "pos","neg"))
trend_model <- lm(spi_3~ year, data = spi_3)
trend_value <- coef(trend_model)[2]  # This is the slope
trend_value_rounded <- round(trend_value, 3)  # Round to 3 decimal places
trend_text <- paste0("Trend: ", trend_value_rounded)
spi_3|>
ggplot(aes(x = year, y = spi_3)) +  # Added missing aes() inside ggplot()
geom_col(aes(fill = sign), show.legend = FALSE, width = 0.65) +  # Removed redundant x and y mappings
geom_smooth(color = "red", method = "lm", se = FALSE, size = 1) +
scale_fill_manual(values = c("pos" = "darkgreen", "neg" = "#FF8109")) +
scale_x_continuous(breaks = seq(1990, 2023, by = 3), expand = c(0.02,0.02)) +
scale_y_continuous(
breaks = seq(-2, 3, by = 0.5),
sec.axis = sec_axis(~ ., name = NULL, breaks = seq(-2, 3, by = 0.5)),
expand = c(0, 0)
)  +
labs(
title = "Hamburg Fuhlsbüttel Standardised Precipitation Index(SPI-3) 1990-2023",
x = "",
y = ""
) +
geom_hline(yintercept = 0, color = "black", linewidth = 0.5) +
coord_cartesian(xlim = c(1990, 2023), ylim = c(-2, 3)) +
theme_minimal() +  # Added theme_minimal() for a clean base theme
theme(
plot.title.position = "plot",
plot.title = element_text(hjust = 0, face = "bold", colour = "black", size = 12, margin = margin(b = 20)),
#plot.subtitle = element_text(hjust = 0, face = "bold", colour = "black", size = 25, margin = margin(b = 20)),
axis.text.x = element_text(angle = 45, hjust = 1, face = "bold", color = "black", size = 10),
axis.text.y = element_text(face = "bold", color = "black", size = 10),
axis.title = element_text(face = "bold", color = "black"),
axis.line = element_line(color = "black", size = 1),
panel.background = element_blank(),
plot.background = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(linewidth = 0.5),
axis.line.y.right = element_line(color = "black", size = 1),
axis.text.y.right = element_text(face = "bold", color = "black", size = 10),
axis.title.y.right = element_text(face = "bold", color = "black", angle = 90),
plot.margin = margin(t = 50, r = 20, b = 20, l = 20, unit = "pt")
)  +
annotate("text", x = 2011, y = 2.15, label = trend_text, size = 4, color = "black", hjust = 0, fontface = "bold")
# Reshape data to long format for easier plotting
observation_annual_tbl_long <- observation_annual_tbl %>%
pivot_longer(
cols = c(Tmin, Tavg, Tmax),
names_to = "Temperature_Type",
values_to = "Temperature"
)
# Create the plot
ggplot(observation_annual_tbl_long, aes(x = year, y = Temperature, color = Temperature_Type)) +
geom_line(linewidth = 1.5) +  # Increased line thickness
geom_point(aes(fill = Temperature_Type, colour = ), shape = 21, size = 1, stroke = 1.5) +  # Increased point size
# Add separate trend lines for each temperature type
geom_smooth(aes(group = Temperature_Type), method = "lm", se = FALSE, size = 1, show.legend = FALSE, color = "blue")  +
scale_color_manual(
values = c("Tmin" = "#1176bc","Tavg" = "#FF8109", "Tmax" = "#c70002"),
labels = c("Minimum Temperature","Average Temperature", "Maximum Temperature")
) +
scale_fill_manual(
values = c("Tmin" = "#1475bc","Tavg" = "#FF8109", "Tmax" = "#c50003"),
guide = "none"
) +
scale_x_continuous(breaks = c(seq(1936, 2023, 10), 2023),
expand = c(0.02, 0.02),
limits = c(1936, 2023)) +
scale_y_continuous(
limits = c(2, 16),
breaks = seq(2, 16, by = 1),
labels = function(x) paste0(format(x, nsmall = 1), "°C"),
sec.axis = sec_axis(~ ., name = NULL, breaks = seq(2, 16, by = 1), labels = function(x) paste0(format(x, nsmall = 1), "°C")),
expand = c(0, 0)
) +
labs(
title = "Hamburg Fuhlsbüttel Temperature Variations 1936-2023",
x = "",
y = "",
color = "Temperature Type"
) +
theme_minimal() +
theme(
plot.title.position = "plot",
plot.title = element_text(hjust = 0, face = "bold", colour = "black", size = 12, margin = margin(b = 20)),
plot.subtitle = element_text(size = 8, colour = "black", margin = margin(b = 10), face = "bold"),
axis.line = element_line(color = "black", size = 1),
axis.ticks = element_blank(),
panel.grid.minor = element_blank(),
panel.grid.major = element_line( linewidth  = 0.5),
axis.text.x = element_text(angle = 45, hjust = 1, face = "bold", color = "black", size = 12),
axis.text.y = element_text(face = "bold", color = "black", size = 12),
legend.text = element_text(size = 10, face = "bold"),
legend.title = element_text(size = 14, face = "bold"),
panel.background = element_blank(),
plot.background = element_blank(),
plot.margin = margin(t = 40, r = 40, b = 20, l = 20, unit = "pt"),
legend.position = "none"  # Remove legend
) +
# Add text annotations for temperature types
annotate("text", x = 1940, y = 15.5, label = "Maximum Temperature",
color = "black", size = 4, fontface = "bold", hjust = - 0.3) +
annotate("text", x = 1940, y = 10, label = "Average Temperature",
color = "black", size = 4, fontface = "bold", hjust = -.3) +
annotate("text", x = 1940, y = 6, label = "Minimum Temperature",
color = "black", size = 4, fontface = "bold", hjust = -.3)
observation_annual_tbl |>
ggplot(aes(year, PREC)) +
geom_point(color = "white", fill = "#16736c", size = 4, shape = 21, stroke = 1.5) +
geom_line(col = "#16736b",linewidth = 1.5) +
setwd("~/Climate-Analysis")
gc()
