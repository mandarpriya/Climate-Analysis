geom_text(aes(y = TMIN, label = round(TMIN, 1)), vjust = 1.5, size = 3) +
scale_x_continuous(breaks = 1:12, labels = month_labels,
position = "top", expand = c(0.5, 0.5)) +
scale_y_continuous(name = NULL,
breaks = seq(-5, 25, by = 5),
limits = c(min(monthly_tbl$TMIN) - 5, max(monthly_tbl$TMAX) + 5)) +
scale_fill_manual(name = NULL,
values = c("Temperature Range" = "red"),
labels = c("Average max. and min. temperatures in °C")) +
theme_minimal() +
theme(
axis.title.x = element_blank(),
axis.text.x = element_text(margin = margin(b = 10)),
axis.ticks.x = element_line(color = "black"),
axis.text.y = element_text(size = 8),
panel.grid.major.x = element_blank(),
panel.grid.minor.x = element_blank(),
plot.margin = margin(t = 5, r = 5, b = 5, l = 5),
legend.position = "bottom",
